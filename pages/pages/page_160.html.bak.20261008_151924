    // fix11: навешиваем .le-auto-fit на ВСЕ картинки без исключений.
    // Inline style="max-width:100%;height:auto;" — главный,
    // .le-auto-fit — подстраховка на случай, если стиль потерялся.
    img.classList.add("le-auto-fit");
  }
}
function highlightSiblings(el){
