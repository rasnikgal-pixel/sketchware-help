.le-tag-sibling{outline:1px solid rgba(52,152,219,.35) !important;outline-offset:1px !important}
.le-tag-current{background:rgba(241,196,15,.18) !important}
img.le-auto-fit{max-width:100% !important;height:auto !important}
.le-inspect-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.75);z-index:2147483646;overflow-y:auto;padding:20px}
.le-inspect-overlay.le-hidden{display:none !important}
.le-inspect-title{color:#fff;font-size:16px;font-weight:bold;margin-bottom:12px}
.le-inspect-item{background:#2c3e50;color:#ecf0f1;padding:8px 12px;border-radius:4px;margin:4px 0;font-size:13px;font-family:monospace;cursor:pointer;border-left:4px solid #3498db}
.le-inspect-item:hover{background:#34495e}
.le-inspect-item small{color:#95a5a6;font-size:11px;margin-left:8px}
.le-inspect-close{position:absolute;top:10px;right:10px;background:#e74c3c;color:#fff;border:none;border-radius:50%;width:40px;height:40px;font-size:20px;font-weight:bold;cursor:pointer}
.le-toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);background:rgba(0,0,0,.85);color:#fff;padding:10px 18px;border-radius:20px;font-size:13px;z-index:2147483645;pointer-events:none;opacity:0;transition:opacity .25s}
