function buildFields(el){
  var host=document.getElementById("le-fields");
  while(host.firstChild) host.removeChild(host.firstChild);
  var tag=el.tagName.toLowerCase();
  var defs=getDefaultsFor(tag);
  if(activeTab==="layout") fieldsLayout(host, el, defs.layout||{});
  else if(activeTab==="text") fieldsText(host, el, tag, defs.text||{});
  else if(activeTab==="attrs") fieldsAttrs(host, el, tag, defs.attrs||{});
  else if(activeTab==="style") fieldsStyle(host, el, defs.style||{});
}
function findIndex(el){
  var tag=el.tagName.toLowerCase();
  var all=document.querySelectorAll(tag);
  for(var i=0;i<all.length;i++) if(all[i]===el) return i;
  return -1;
}
function pageFile(){ return (window.location.pathname||"").split("/").pop(); }
function applyAndSave(){
  if(!currentEl){closeOverlay();return;}
  var el=currentEl;
  var marker = "__LE_MARK_" + Date.now() + "_" + Math.floor(Math.random()*100000);
  el.setAttribute("data-le-marker", marker);
  var fullHTML = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
  el.removeAttribute("data-le-marker");
  logToDS({
    type:"HE_SAVE",
    file:pageFile(),
    tag:el.tagName.toLowerCase(),
    index:findIndex(el),
    marker:marker,
    fullHTML:fullHTML
  });
  closeOverlay();
}
function duplicateElement(){
  if(!currentEl){closeOverlay();return;}
  var el=currentEl;
  var clone=el.cloneNode(true);
  clone.classList.remove("le-highlight");
  clone.classList.remove("le-tag-current");
  clone.classList.remove("le-tag-sibling");
  if(el.parentNode) el.parentNode.insertBefore(clone, el.nextSibling);
  closeOverlay();
}
function deleteElement(){
  if(!currentEl){closeOverlay();return;}
  var el=currentEl;
  var marker = "__LE_MARK_" + Date.now() + "_" + Math.floor(Math.random()*100000);
  el.setAttribute("data-le-marker", marker);
  var fullHTML = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
  el.removeAttribute("data-le-marker");
  logToDS({
    type:"HE_DELETE",
    file:pageFile(),
    tag:el.tagName.toLowerCase(),
    index:findIndex(el),
    marker:marker,
    fullHTML:fullHTML
  });
  if(el.parentNode) el.parentNode.removeChild(el);
  closeOverlay();
}
function toggleInspector(){
  if(inspectorActive){ closeInspector(); return; }
  inspectorActive=true;
  if(!inspectorOverlay){
    inspectorOverlay=document.createElement("div");
    inspectorOverlay.className="le-inspect-overlay le-hidden";
    document.body.appendChild(inspectorOverlay);
  }
  var html = '<button class="le-inspect-close" id="le-inspect-close">×</button>' +
             '<div class="le-inspect-title">Инспектор — все элементы страницы</div>';
  var els = document.querySelectorAll("body *");
  for(var i=0;i<els.length;i++){
    var el = els[i];
    if(/^(SCRIPT|STYLE|HEAD|META|LINK|TITLE)$/i.test(el.tagName)) continue;
    var tag=el.tagName.toLowerCase();
    var info="";
    if(el.id) info="#"+el.id;
    else if(typeof el.className==="string" && el.className) info="."+el.className.split(" ")[0];
    var txt = (el.textContent||"").trim().slice(0,40);
    html += '<div class="le-inspect-item" data-idx="'+i+'">'+
            tag+(info?' <small>'+info+'</small>':'')+(txt?' <small>«'+txt+'»</small>':'')+'</div>';
  }
  inspectorOverlay.innerHTML = html;
  inspectorOverlay.classList.remove("le-hidden");
  document.getElementById("le-inspect-close").addEventListener("click",closeInspector);
  var items = inspectorOverlay.querySelectorAll(".le-inspect-item");
  for(var j=0;j<items.length;j++){
    items[j].addEventListener("click",function(){
      var idx=parseInt(this.getAttribute("data-idx"));
      var el=els[idx];
      if(el){ closeInspector(); openOverlay(el); }
    });
  }
}
function closeInspector(){
  inspectorActive=false;
  if(inspectorOverlay) inspectorOverlay.classList.add("le-hidden");
}
function onPointerDown(e){
  if(inspectorActive) return;
  if(longPressTimer){ clearTimeout(longPressTimer); longPressTimer=null; }
  var t=e.touches?e.touches[0]:e;
  if(!t) return;
  var sx=t.clientX, sy=t.clientY;
  var target=e.target;
  if(!target) return;
  if(/^(HTML|BODY|SCRIPT|STYLE|HEAD|META|LINK|TITLE)$/i.test(target.tagName)) return;
  var startTime = Date.now();
  longPressTimer=setTimeout(function(){
    longPressTimer=null;
    try{ if(navigator.vibrate) navigator.vibrate(30); }catch(_){}
    openOverlay(target);
  }, LONG_PRESS_MS);
  function move(ev){
    var tt=ev.touches?ev.touches[0]:ev;
    if(!tt) return;
    if(Math.abs(tt.clientX-sx)>MOVE_TOLERANCE || Math.abs(tt.clientY-sy)>MOVE_TOLERANCE){
      if(longPressTimer){ clearTimeout(longPressTimer); longPressTimer=null; }
      document.removeEventListener("touchmove", move);
      document.removeEventListener("mousemove", move);
    }
  }
  document.addEventListener("touchmove", move, {passive:true});
  document.addEventListener("mousemove", move);
  target._leDownTime = startTime;
}
function onPointerUp(e){
  var target = e ? e.target : null;
  var elapsed = target && target._leDownTime ? (Date.now() - target._leDownTime) : 99999;
  if(elapsed < LONG_PRESS_MS - 100){
    if(longPressTimer){ clearTimeout(longPressTimer); longPressTimer=null; }
  } else {
    if(longPressTimer){ clearTimeout(longPressTimer); longPressTimer=null; }
  }
}
document.addEventListener("touchstart", onPointerDown, {passive:true, capture:true});
document.addEventListener("touchend", onPointerUp, {passive:true, capture:true});
document.addEventListener("touchcancel", onPointerUp, {passive:true, capture:true});
document.addEventListener("mousedown", onPointerDown, {capture:true});
document.addEventListener("mouseup", onPointerUp, {capture:true});
var tapCount=0, tapTimer=null;
document.addEventListener("touchstart", function(){
  tapCount++;
  if(tapTimer) clearTimeout(tapTimer);
  tapTimer = setTimeout(function(){ tapCount=0; }, 500);
  if(tapCount>=3){ tapCount=0; toggleInspector(); }
}, {passive:true});
window.addEventListener("load", applyImgAutoFit);
window.addEventListener("DOMContentLoaded", applyImgAutoFit);
})();
</script>

