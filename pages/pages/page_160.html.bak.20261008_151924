function isTagEnabled(tag){
  tag = (tag||"").toLowerCase();
  if(tag==="img") return !!FLAGS.live_img_enabled;
  if(tag==="a") return !!FLAGS.live_a_enabled;
  if(tag==="table") return !!FLAGS.live_table_enabled;
  if(tag==="td"||tag==="th") return !!FLAGS.live_td_enabled;
  if(tag==="ul"||tag==="ol"||tag==="li") return !!FLAGS.live_ul_enabled;
  if(tag==="hr") return !!FLAGS.live_hr_enabled;
  if(tag==="input"||tag==="textarea") return !!FLAGS.live_input_enabled;
  if(tag==="button") return !!FLAGS.live_button_enabled;
  if(tag==="video") return !!FLAGS.live_video_enabled;
  if(tag==="audio") return !!FLAGS.live_audio_enabled;
  if(tag==="iframe") return !!FLAGS.live_iframe_enabled;
  if(tag==="p") return !!FLAGS.live_p_enabled;
  if(/^h[1-6]$/.test(tag)) return !!FLAGS.live_heading_enabled;
  if(tag==="div") return !!FLAGS.live_div_enabled;
  if(tag==="span") return !!FLAGS.live_span_enabled;
  if(tag==="section") return !!FLAGS.live_section_enabled;
  if(tag==="nav") return !!FLAGS.live_nav_enabled;
  if(tag==="aside") return !!FLAGS.live_aside_enabled;
  if(tag==="header") return !!FLAGS.live_header_enabled;
  if(tag==="footer") return !!FLAGS.live_footer_enabled;
  return true;
}
function parseDefaults(str){
  var out={layout:{},text:{},attrs:{},style:{}};
  if(!str) return out;
  var parts = str.split(";");
  for(var i=0;i<parts.length;i++){
    var p=parts[i].trim(); if(!p) continue;
    var kv=p.split(":");
    if(kv.length!==2) continue;
    var group=kv[0].trim(), fields=kv[1].split(",");
    for(var j=0;j<fields.length;j++){
      var f=fields[j].trim(); if(f) out[group][f]=true;
    }
  }
  return out;
}
function getDefaultsFor(tag){
  if(tag==="img") return parseDefaults(DEFAULTS.img);
  if(tag==="a") return parseDefaults(DEFAULTS.a);
  if(tag==="table") return parseDefaults(DEFAULTS.table);
  if(tag==="td"||tag==="th") return parseDefaults(DEFAULTS.td);
  if(tag==="ul"||tag==="ol") return parseDefaults(DEFAULTS.ul);
  if(tag==="hr") return parseDefaults(DEFAULTS.hr);
  if(tag==="input") return parseDefaults(DEFAULTS.input);
  if(tag==="button") return parseDefaults(DEFAULTS.button);
  if(tag==="video") return parseDefaults(DEFAULTS.video);
  if(tag==="audio") return parseDefaults(DEFAULTS.audio);
  if(tag==="iframe") return parseDefaults(DEFAULTS.iframe);
  return parseDefaults(DEFAULTS.other);
}
