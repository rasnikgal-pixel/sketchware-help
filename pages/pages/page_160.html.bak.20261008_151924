function clearHighlight(){
  var list=document.querySelectorAll(".le-highlight");
  for(var i=0;i<list.length;i++) list[i].classList.remove("le-highlight");
}
function resetElementStyles(){
  if(!currentEl) return;
  currentEl.removeAttribute("style");
  currentEl.classList.remove("le-highlight");
  currentEl.classList.add("le-highlight");
  highlightSiblings(currentEl);
  buildFields(currentEl);
}
function wrapInDiv(){
  if(!currentEl || !currentEl.parentNode) return;
  var wrapper=document.createElement("div");
  wrapper.style.maxWidth="100%";
  currentEl.parentNode.insertBefore(wrapper, currentEl);
  wrapper.appendChild(currentEl);
  closeOverlay();
  showToast("Обёрнуто в div");
}
function unwrapFromParent(){
  if(!currentEl || !currentEl.parentNode) return;
  var p = currentEl.parentNode;
  if(p===document.body) return;
  var gp = p.parentNode;
  if(!gp) return;
  while(currentEl.firstChild) gp.insertBefore(currentEl.firstChild, p);
  if(p.childNodes.length===0) gp.removeChild(p);
  closeOverlay();
  showToast("Вынесено из родителя");
}
function makeHeading(){
  if(!currentEl) return;
  var choice = prompt("Уровень заголовка (1-6):", "2");
  if(!choice) return;
  var lvl = parseInt(choice);
  if(isNaN(lvl) || lvl<1 || lvl>6) return;
  var newTag = "h"+lvl;
  var newEl = document.createElement(newTag);
  newEl.innerHTML = currentEl.innerHTML;
  if(currentEl.getAttribute("style")) newEl.setAttribute("style", currentEl.getAttribute("style"));
  currentEl.parentNode.replaceChild(newEl, currentEl);
  currentEl = newEl;
  buildFields(currentEl);
}
function addTextRow(host,label,value,onchange){
  var row=document.createElement("div"); row.className="le-row";
  var l=document.createElement("label"); l.textContent=label;
  var inp=document.createElement("input"); inp.type="text"; inp.value=value||"";
  inp.addEventListener("input",function(){onchange(inp.value);});
  row.appendChild(l); row.appendChild(inp); host.appendChild(row);
}
function addNumberRow(host,label,value,onchange){
  var row=document.createElement("div"); row.className="le-row";
  var l=document.createElement("label"); l.textContent=label;
  var inp=document.createElement("input"); inp.type="number"; inp.value=value||"";
  inp.addEventListener("input",function(){onchange(inp.value);});
  row.appendChild(l); row.appendChild(inp); host.appendChild(row);
}
function addColorRow(host,label,value,onchange){
  var row=document.createElement("div"); row.className="le-row";
  var l=document.createElement("label"); l.textContent=label;
  var inp=document.createElement("input"); inp.type="color";
  if(value && /^#/.test(value)) inp.value=value;
  var txt=document.createElement("input"); txt.type="text"; txt.value=value||"";
  txt.style.flex="1";
  inp.addEventListener("input",function(){ txt.value=inp.value; onchange(inp.value); });
  txt.addEventListener("input",function(){ onchange(txt.value); });
  row.appendChild(l); row.appendChild(inp); row.appendChild(txt); host.appendChild(row);
}
function addSelectRow(host,label,value,options,onchange){
  var row=document.createElement("div"); row.className="le-row";
  var l=document.createElement("label"); l.textContent=label;
  var sel=document.createElement("select");
  for(var i=0;i<options.length;i++){
    var opt=document.createElement("option"); opt.value=options[i]; opt.textContent=options[i];
    if(options[i]===value) opt.selected=true;
    sel.appendChild(opt);
  }
  sel.addEventListener("change",function(){onchange(sel.value);});
  row.appendChild(l); row.appendChild(sel); host.appendChild(row);
}
function addCheckRow(host,label,checked,onchange){
  var row=document.createElement("div"); row.className="le-row";
  var l=document.createElement("label"); l.textContent=label;
  var inp=document.createElement("input"); inp.type="checkbox"; inp.checked=!!checked;
  inp.addEventListener("change",function(){onchange(inp.checked);});
  row.appendChild(l); row.appendChild(inp); host.appendChild(row);
}
function addSizeRowWithRatio(host, label, prop, el, min, max){
  min=min||0; max=max||1200;
  var isW = (prop==="width");
  var cur = parseInt(el.style[prop]) || parseInt(el.getAttribute(prop)) ||
            parseInt(getComputedStyle(el)[prop]) || 0;
  var row=document.createElement("div"); row.className="le-row";
  var lbl=document.createElement("label"); lbl.textContent=label;
  var rng=document.createElement("input"); rng.type="range"; rng.min=min; rng.max=max; rng.step=1; rng.value=cur;
  var num=document.createElement("input"); num.type="number"; num.value=cur; num.style.maxWidth="80px"; num.style.flex="0 0 80px";
  function apply(v, skipRatio){
    v=parseInt(v)||0;
    var ratio = getAspectRatio(el);
    if(v>0) el.style[prop]=v+"px"; else el.style[prop]="";
    rng.value=v; num.value=v;
    if(v>0) el.classList.remove("le-auto-fit");
    if(lockAspect && ratio>0 && !skipRatio && v>0){
      var otherProp = isW ? "height" : "width";
      var otherVal = isW ? Math.round(v/ratio) : Math.round(v*ratio);
      el.style[otherProp] = otherVal + "px";
      var otherInput = document.querySelector('.le-row[data-size="'+otherProp+'"]');
      if(otherInput){
        var oRng = otherInput.querySelector('input[type=range]');
        var oNum = otherInput.querySelector('input[type=number]');
        if(oRng) oRng.value = otherVal;
        if(oNum) oNum.value = otherVal;
      }
    }
  }
  row.setAttribute("data-size", prop);
  rng.addEventListener("input",function(){apply(rng.value);});
  num.addEventListener("input",function(){apply(num.value);});
  row.appendChild(lbl); row.appendChild(rng); row.appendChild(num); host.appendChild(row);
}
function getAspectRatio(el){
  var w = el.offsetWidth || parseInt(el.style.width) || 0;
  var h = el.offsetHeight || parseInt(el.style.height) || 0;
  if(w>0 && h>0) return w/h;
  return 0;
}
