.le-btn-close{background:#7f8c8d}
.le-btn-delete{background:#e74c3c}
.le-btn-dup{background:#9b59b6}
.le-btn-reset{background:#e67e22}
.le-btn-wrap{background:#16a085}
.le-btn-unwrap{background:#d35400}
.le-btn-heading{background:#2980b9}
.le-btn-crop{background:#f39c12;font-size:14px !important;padding:12px !important;width:100%}
