function openOverlay(el){
  if(!el) return;
  var tag = el.tagName.toLowerCase();
  if(!isTagEnabled(tag)){
    showToast("Редактор для тега <"+tag+"> отключён в настройках Live");
    return;
  }
  currentEl=el; activeTab="layout";
  lockAspect = LOCK_ASPECT_DEFAULT;
  var ov=ensureOverlay();
  ov.classList.remove("le-hidden");
  document.getElementById("le-elname").textContent=tag;
  var info="";
  if(tag==="img") info=(el.getAttribute("src")||"").split("/").pop();
  else if(el.id) info="#"+el.id;
  else if(typeof el.className==="string" && el.className) info="."+el.className.split(" ")[0];
  document.getElementById("le-elinfo").textContent=info;
  var ti=document.getElementById("le-taginfo");
  if(ti){
    var idx=findIndex(el);
    ti.innerHTML="<span>Тег: <b>"+tag+"</b></span>"+
      "<span>Индекс: <b>"+idx+"</b></span>"+
      "<span>Дочерних: <b>"+el.children.length+"</b></span>";
  }
  var fitRow=document.getElementById("le-imgfit-row");
  var fitChk=document.getElementById("le-imgfit");
  if(fitRow && fitChk){
    if(tag==="img"){
      fitRow.style.display="flex";
      fitChk.checked = !!IMG_AUTO_MAX_WIDTH;
    } else {
      fitRow.style.display="none";
    }
  }
  var cropBlock=document.getElementById("le-crop-block");
  if(cropBlock) cropBlock.style.display=(tag==="img")?"block":"none";
  var all=ov.querySelectorAll(".le-tab");
  for(var i=0;i<all.length;i++) all[i].classList.remove("active");
  var first=ov.querySelector('[data-tab="layout"]'); if(first) first.classList.add("active");
  buildFields(el);
  clearHighlight();
  el.classList.add("le-highlight");
  highlightSiblings(el);
}
function closeOverlay(){
  if(overlay) overlay.classList.add("le-hidden");
  clearHighlight();
  clearSiblingsHighlight();
  currentEl=null;
  if(longPressTimer){ clearTimeout(longPressTimer); longPressTimer=null; }
