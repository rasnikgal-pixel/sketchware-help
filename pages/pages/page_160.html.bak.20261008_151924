    if(all[i]===el) all[i].classList.add("le-tag-current");
    else all[i].classList.add("le-tag-sibling");
  }
}
function clearSiblingsHighlight(){
  var list = document.querySelectorAll(".le-tag-sibling, .le-tag-current");
